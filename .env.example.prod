# PostgreSQL
POSTGRES_DB=gym_prod
POSTGRES_USER=gym_prod_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Django
DEBUG=False
SECRET_KEY=CHANGE_ME_GENERATE_WITH_secrets.token_urlsafe
ALLOWED_HOSTS=example.com,www.example.com
DJANGO_SETTINGS_MODULE=gym_backend.settings
DB_NAME=gym_prod
DB_USER=gym_prod_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgres://gym_prod_user:CHANGE_ME_STRONG_PASSWORD@db:5432/gym_prod
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOW_CREDENTIALS=True
JWT_ACCESS_MIN=60
JWT_REFRESH_DAYS=7
USE_S3=False
MEDIA_URL=/media/
STATIC_URL=/static/
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
